{
  "name": "coweb-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Build tooling for the CoWeb WordPress theme. One stylesheet, no bundler.",
  "scripts": {
    "dev": "sass --watch --style=expanded --source-map assets/scss/main.scss assets/css/main.css",
    "build": "sass --no-source-map --style=compressed assets/scss/main.scss assets/css/main.css",
    "lint:css": "stylelint \"assets/scss/**/*.scss\""
  },
  "devDependencies": {
    "sass": "^1.80.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
