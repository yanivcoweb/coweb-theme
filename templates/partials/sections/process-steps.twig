{#
	ACF layout: process_steps — Figma `process-steps` + `process-step`.

	Step numbers are generated, exactly like the capability card index.

	With `background_image`: a 65% scrim, and each step becomes a lifted panel.
#}

<section class="process-steps{% if section.background_image %} process-steps--background{% endif %}">
	<div class="container process-steps__inner">

		{% include 'partials/ui/section-header.twig' with {
			eyebrow: section.eyebrow,
			heading: section.heading,
			intro: section.intro
		} only %}

		{% if section.steps %}
			<ol class="process-steps__list">
				{% for step in section.steps %}
					<li class="process-step">
						<p class="process-step__number">{{ '%02d'|format(loop.index) }}</p>
						<h3 class="process-step__title">{{ step.title }}</h3>
						<p class="process-step__body">{{ step.body }}</p>
					</li>
				{% endfor %}
			</ol>
		{% endif %}

	</div>

	{# Last child on purpose: reveal.js animates the children of the FIRST child. #}
	{% include 'partials/ui/section-background.twig' with {
		image: section.background_image,
		scrim: 'strong'
	} only %}

</section>
