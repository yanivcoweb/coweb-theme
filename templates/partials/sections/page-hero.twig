{#
	ACF layout: page_hero — Figma `page-hero`.

	The inner-page counterpart to hero_main: breadcrumb, h1, intro. Same rule
	applies — one per page, and it carries the h1.

	`background_image` is optional. It loads eagerly — an inner page's hero photo
	is its LCP candidate — under a 60% scrim, and without the hero's ember glow:
	the frames put that on the home page only.

	`eyebrow` is optional and replaces the trail when set: `about` (15:62) draws
	one accent label there instead of breadcrumbs. Empty, the trail renders as
	on every other inner page.
#}

<section class="page-hero-section{% if section.background_image %} page-hero-section--background{% endif %}">
	<div class="container page-hero">

		{% if section.eyebrow %}
			<p class="page-hero__eyebrow">{{ section.eyebrow }}</p>
		{% else %}
			{% include 'partials/ui/breadcrumbs.twig' with {} only %}
		{% endif %}

		{% if section.title %}
			<h1 class="page-hero__title">{{ section.title }}</h1>
		{% endif %}

		{% if section.intro %}
			<p class="page-hero__intro">{{ section.intro }}</p>
		{% endif %}

		{% if section.tags %}
			<ul class="tag-list">
				{% for tag in section.tags %}
					<li>{% include 'partials/ui/tag-chip.twig' with { label: tag.label } only %}</li>
				{% endfor %}
			</ul>
		{% endif %}

	</div>

	{# Last child on purpose: reveal.js animates the children of the FIRST child. #}
	{% include 'partials/ui/section-background.twig' with {
		image: section.background_image,
		scrim: 'deep',
		eager: true
	} only %}

</section>
