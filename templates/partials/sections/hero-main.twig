{#
	ACF layout: hero_main — Figma `hero-main`.

	Carries the page's h1. Every other section uses h2, so this partial belongs
	at the top of a page and nowhere else.

	`background_image` is optional. It loads eagerly — the hero photo is the
	page's LCP candidate — under a 55% scrim with the ember glow on top.
#}

<section class="hero-main{% if section.background_image %} hero-main--background{% endif %}">
	<div class="container hero-main__inner">

		{% if section.eyebrow %}
			<p class="hero-main__eyebrow">{{ section.eyebrow }}</p>
		{% endif %}

		{% if section.heading %}
			<h1 class="hero-main__heading">{{ section.heading }}</h1>
		{% endif %}

		{% if section.intro %}
			<p class="hero-main__intro">{{ section.intro }}</p>
		{% endif %}

		{% if section.actions %}
			<div class="hero-main__actions">
				{% for action in section.actions %}
					{% include 'partials/ui/button.twig' with {
						link: action.link,
						variant: action.variant
					} only %}
				{% endfor %}
			</div>
		{% endif %}

	</div>

	{# Last child on purpose: reveal.js animates the children of the FIRST child. #}
	{% include 'partials/ui/section-background.twig' with {
		image: section.background_image,
		scrim: 'medium',
		glow: true,
		eager: true
	} only %}

</section>
