{#
	Global header. RTL: wordmark on the start edge (right), CTA on the end (left).

	No row-reverse — under dir="rtl" flex mirrors itself, so the DOM order is
	simply the reading order and the browser does the work.
#}

<header class="site-header">
	<div class="container site-header__inner">

		<a class="site-header__logo" href="{{ home_url }}" rel="home">
			<span>co</span><span>web</span>
		</a>

		<button
			class="site-header__toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-nav"
			data-menu-open
		>
			<span class="screen-reader-text">פתיחת תפריט</span>
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
				<path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
			</svg>
		</button>

		<nav class="site-nav" id="site-nav" aria-label="ניווט ראשי">

			{#
				The drawer is position:fixed inset:0, so it covers the header
				it opened from — including the wordmark. Figma repeats the
				wordmark here for that reason (mobile-menu-open, 95:12).

				It is decorative, not a second way home: the header's own logo
				is one tab stop away behind the overlay, and a duplicate link
				to the same URL is a duplicate stop for a screen reader. So it
				is a span, not an anchor, and aria-hidden sits on the wordmark
				itself — never on the bar, which would take the close button
				out of the accessibility tree with it and leave a focusable
				control inside a hidden subtree.
			#}
			<div class="site-nav__bar">
				<span class="site-nav__logo" aria-hidden="true"><span>co</span><span>web</span></span>

				<button class="site-nav__close" type="button" data-menu-close>
					<span class="screen-reader-text">סגירת תפריט</span>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
						<path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
					</svg>
				</button>
			</div>

			{% if nav %}
				<ul class="site-nav__list">
					{% for item in nav.items %}
						<li class="site-nav__item">
							<a
								class="site-nav__link"
								href="{{ item.link }}"
								{% if item.current or item.current_item_ancestor %}aria-current="page"{% endif %}
							>{{ item.title }}</a>
						</li>
					{% endfor %}
				</ul>
			{% endif %}

			{#
				Figma `menu-bottom` (95:24): the CTA on the start edge, then
				email and phone. Mobile only — above the tablet breakpoint the
				CTA sits in the header bar and the footer carries the rest.

				This block is why the drawer used to look wrong. It was never
				built, so the drawer had exactly two children and the
				space-between meant to separate three of them pushed the nav
				list to the floor.
			#}
			<div class="site-nav__footer">
				{% if cta.url %}
					<a class="button button--primary" href="{{ cta.url }}"{% if cta.target %} target="{{ cta.target }}" rel="noopener"{% endif %}>
						{{ cta.title }}
					</a>
				{% endif %}

				{% if email %}
					<a class="site-nav__contact" href="mailto:{{ email }}">{{ email }}</a>
				{% endif %}

				{% if phone %}
					<a class="site-nav__contact" href="tel:{{ phone|replace({'-': '', ' ': ''}) }}">{{ phone }}</a>
				{% endif %}
			</div>
		</nav>

		{% if cta.url %}
			<a class="button button--primary site-header__cta" href="{{ cta.url }}"{% if cta.target %} target="{{ cta.target }}" rel="noopener"{% endif %}>
				{{ cta.title }}
			</a>
		{% endif %}

	</div>
</header>
