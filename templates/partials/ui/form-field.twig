{#
	Maps to the Figma `form-field` component set (Type × State).

	The label is always a real <label for> — never a placeholder standing in for
	one, because a placeholder disappears the moment someone starts typing.

	The error state is not just the red border: aria-invalid marks the control
	and aria-describedby points at the message, so a screen reader is told what
	the colour is trying to say.
#}

{% set field_id = 'field-' ~ name %}
{% set error_id = field_id ~ '-error' %}

<div class="form-field{{ error ? ' form-field--error' : '' }}">

	<label class="form-field__label" for="{{ field_id }}">
		{{ label }}{% if required %} <span class="form-field__required" aria-hidden="true">*</span>{% endif %}
	</label>

	{% if type == 'textarea' %}
		<textarea
			class="form-field__control form-field__control--textarea"
			id="{{ field_id }}"
			name="{{ name }}"
			rows="5"
			placeholder="{{ placeholder }}"
			{% if required %}required aria-required="true"{% endif %}
			{% if error %}aria-invalid="true" aria-describedby="{{ error_id }}"{% endif %}
		>{{ value }}</textarea>
	{#
		`select` is not a variant in the Figma component — the file draws text
		controls only. It takes the same control class, so fill, border, radius
		and focus ring are the input's, and keeps the browser's own arrow and
		option list: a custom one would need a script and its own keyboard model
		to stay AA. `options` is a key => label map; `placeholder` is the empty
		first option, which is what makes an optional select leavable.
	#}
	{% elseif type == 'select' %}
		<select
			class="form-field__control form-field__control--select"
			id="{{ field_id }}"
			name="{{ name }}"
			{% if required %}required aria-required="true"{% endif %}
			{% if error %}aria-invalid="true" aria-describedby="{{ error_id }}"{% endif %}
		>
			<option value="">{{ placeholder }}</option>
			{% for key, option_label in options %}
				<option value="{{ key }}"{% if key == value %} selected{% endif %}>{{ option_label }}</option>
			{% endfor %}
		</select>
	{% else %}
		<input
			class="form-field__control"
			id="{{ field_id }}"
			name="{{ name }}"
			type="{{ type|default('text') }}"
			value="{{ value }}"
			placeholder="{{ placeholder }}"
			{% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
			{% if required %}required aria-required="true"{% endif %}
			{% if error %}aria-invalid="true" aria-describedby="{{ error_id }}"{% endif %}
		>
	{% endif %}

	{% if error %}
		<p class="form-field__error" id="{{ error_id }}">{{ error }}</p>
	{% endif %}

</div>
