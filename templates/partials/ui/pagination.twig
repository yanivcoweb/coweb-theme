{#
	Maps to the Figma `pagination` component.

	RTL: previous sits on the start edge (the right), next on the left. That
	falls out of the DOM order under dir="rtl" with no reversing.

	The current page is marked with aria-current so it is announced, not just
	coloured — colour alone carries no meaning.
#}

{% if pagination.pages|length > 1 %}
	<nav class="pagination" aria-label="ניווט בין עמודים">

		{% if pagination.prev %}
			<a class="pagination__step" href="{{ pagination.prev.link }}" rel="prev">הקודם</a>
		{% endif %}

		<ul class="pagination__list">
			{% for page in pagination.pages %}
				<li>
					{% if page.link %}
						<a
							class="pagination__page{{ page.current ? ' pagination__page--current' : '' }}"
							href="{{ page.link }}"
							{% if page.current %}aria-current="page"{% endif %}
						>{{ page.title }}</a>
					{% else %}
						<span class="pagination__ellipsis">{{ page.title }}</span>
					{% endif %}
				</li>
			{% endfor %}
		</ul>

		{% if pagination.next %}
			<a class="pagination__step" href="{{ pagination.next.link }}" rel="next">הבא</a>
		{% endif %}

	</nav>
{% endif %}
